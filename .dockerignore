# Keep secrets, local state and heavy build artefacts out of the Docker build context.
.git
.github
.env
.env.*
!.env.example
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.ruff_cache
**/.venv
**/venv
*.db
*.db-wal
*.db-shm
*.sqlite3
frontend/node_modules
frontend/dist
backend/tests
.claude
.DS_Store
.vscode
.idea
