# QuantAI Environment Configuration Example
# Copy to .env and populate locally. NEVER commit .env or real API keys to GitHub.
# Precedence: a non-empty real environment variable always overrides the value in .env.

QUANTAI_ENV=development
QUANTAI_DB_PATH=./backend/quantai.db
# Explicit origins only. "*" is accepted but allows any website to call the API.
QUANTAI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
QUANTAI_HTTP_TIMEOUT=15.0

# --- $0 Free Stack Providers ---
# Finnhub free API key (https://finnhub.io) — enables US real-time quotes & WebSocket trades (60 calls/min)
FINNHUB_API_KEY=

# Optional Google Gemini API key (https://aistudio.google.com/apikey) — enables LLM Q&A inside Diverse-Risk Advisor
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# SSI FastConnect Data API v2 (https://guide.ssi.com.vn/ssi-products/fastconnect-data) — needs an SSI trading account
# and an FC Data registration; use the ConsumerID / ConsumerSecret from iBoard. (Legacy names SSI_API_KEY / SSI_API_SECRET also work.)
SSI_CONSUMER_ID=
SSI_CONSUMER_SECRET=

# Vnstock v6 (https://vnstocks.com) — optional Open API key and preferred source (VCI, TCBS, SSI, DNSE)
VNSTOCK_API_KEY=
VNSTOCK_SOURCE=VCI

# Frankfurter v2 open-source FX reference API (no API key required)
FRANKFURTER_BASE_URL=https://api.frankfurter.dev/v2

# Explicit educational historical fallback toggle for yfinance (never labeled LIVE)
QUANTAI_ENABLE_YFINANCE_FALLBACK=true

# --- Optional Paid Providers (Inactive in $0 MVP) ---
EODHD_API_KEY=
TWELVEDATA_API_KEY=
MASSIVE_API_KEY=

# --- Public deployment (see docs/deployment.md) ---
# Serve the built UI from the API process (the Docker image sets /app/frontend/dist).
QUANTAI_FRONTEND_DIST=
# Rate limiting is ON by default when QUANTAI_ENV=production. 0 disables a rule.
QUANTAI_RATE_LIMIT_ENABLED=
QUANTAI_RATE_LIMIT_PER_MINUTE=240
QUANTAI_RATE_LIMIT_HEAVY_PER_MINUTE=20
QUANTAI_ASSISTANT_PER_MINUTE=6
# Global cap on Gemini assistant calls per UTC day (all visitors combined).
QUANTAI_ASSISTANT_DAILY_BUDGET=200
